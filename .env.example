APP_NAME=Laravel
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:4200

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Railway: configura DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME y DB_PASSWORD
# mediante referencias privadas al servicio PostgreSQL. Deja DB_URL sin definir.
# DB_SSLMODE=prefer
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Genera un valor aleatorio de 64 caracteres, p. ej.: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=1440

# Solo en desarrollo y con conexion verificada autorizada; no habilita emision institucional.
CERTIFICATION_DEVELOPMENT_CLOSURE_ENABLED=false
CERTIFICATION_PREPARATION_SESSION_TYPE_IDS=
CERTIFICATION_DEVELOPMENT_CONNECTION_AUTHORIZED=false
CERTIFICATION_DEVELOPMENT_CONNECTION=
CERTIFICATION_DEVELOPMENT_DATABASE=
CERTIFICATION_DEVELOPMENT_USERNAME=
CERTIFICATION_DEVELOPMENT_SERVER_ADDRESS=
CERTIFICATION_DEVELOPMENT_SERVER_PORT=
CERTIFICATION_DEVELOPMENT_SESSION_TYPE_IDS=
CERTIFICATION_DEVELOPMENT_SCHEMA_AUTHORIZED=false

# Opcional: base publica de verificacion. Demo usa APP_URL y su ruta Laravel; borradores usan FRONTEND_URL.
# No habilita emision oficial ni modifica certificados ya almacenados.
CERTIFICATION_PUBLIC_VERIFICATION_BASE_URL=
CERTIFICATION_ALLOW_HTTP_LAN_VERIFICATION=false
CERTIFICATION_PUBLIC_BENEFICIARY_NAME=false

# Solo documentos academicos seleccionados con consentimiento documentado.
# Codigos exactos separados por |; vacio mantiene los PDFs administrativos privados.
CERTIFICATION_PUBLIC_PDF_POLICY_REFERENCE=
CERTIFICATION_PUBLIC_PDF_CODES=

# Simulacion de Etapa B, accesible exclusivamente con APP_ENV=local y permisos de gestion.
CERTIFICATION_STAGE_B_DEMO_ENABLED=false

# Preparacion academica individual: solo local/development; listas exactas y opt-in.
CERTIFICATION_RECOGNITION_ACADEMIC_ENABLED=false
CERTIFICATION_RECOGNITION_ACADEMIC_IDS=
CERTIFICATION_RECOGNITION_ACADEMIC_STATES=
